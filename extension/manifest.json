{
  "manifest_version": 3,
  "name": "Vaultly",
  "version": "1.3.0",
  "description": "Secure shared account access via automatic cookie injection",
  "permissions": [
    "cookies",
    "storage",
    "tabs",
    "activeTab",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_popup": "public/popup.html",
    "default_title": "Vaultly"
  },
  "web_accessible_resources": [
    {
      "resources": ["public/**"],
      "matches": ["<all_urls>"]
    }
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost:3000/*",
      "https://*.vercel.app/*",
      "https://*.supabase.co/*"
    ]
  }
}
